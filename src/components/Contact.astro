---
import { content, contact } from '../data/site';
import { getLang } from '../i18n';
const lang = getLang(Astro.url);
const L = content[lang];
const c = L.contact;
const items = [
  {
    label: c.email,
    value: contact.email,
    href: `mailto:${contact.email}`,
    icon: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  },
  {
    label: c.phone,
    value: contact.phoneDisplay,
    href: contact.phoneHref,
    icon: '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/>',
  },
  {
    label: c.instagram,
    value: contact.instagramHandle,
    href: contact.instagramHref,
    icon: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/>',
  },
];
---

<section class="section space" id="contact">
  <div class="wrap grid">
    <div>
      <p class="kicker reveal">{c.kicker}</p>
      <h2 class="h2 reveal" data-split>{c.title}</h2>
      <p class="text reveal" style="--d:.14s">{c.text}</p>
    </div>
    <ul class="list">
      {items.map((it, i) => (
        <li class="reveal" style={`--d:${0.1 + i * 0.08}s`}>
          <a href={it.href} target={it.href.startsWith('http') ? '_blank' : undefined} rel={it.href.startsWith('http') ? 'noopener' : undefined}>
            <span class="ic" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={it.icon} />
            </span>
            <span class="lbl">{it.label}<b dir="ltr">{it.value}</b></span>
            <svg class="arr" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 6vw, 90px); align-items: center; }
  .text { color: #cfcce0; max-width: 460px; margin: 0; }
  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .list a {
    display: flex; align-items: center; gap: 18px;
    padding: 20px 22px;
    border-radius: 16px;
    border: 1px solid var(--line);
    background: rgba(14,15,30,.7);
    transition: border-color .4s, transform .5s var(--ease), box-shadow .5s;
  }
  .list a:hover { border-color: var(--teal); transform: translateX(6px); box-shadow: 0 0 40px -14px rgba(34,211,197,.6); }
  html[dir='rtl'] .list a:hover { transform: translateX(-6px); }
  .ic { flex: none; width: 52px; height: 52px; border-radius: 50%; display: grid; place-items: center; color: var(--copper-light); background: radial-gradient(circle at 35% 30%, #2a1a12, #0c0a12 70%); box-shadow: 0 0 0 1px rgba(255,140,70,.3); }
  .ic svg { width: 24px; height: 24px; }
  .lbl { display: flex; flex-direction: column; font-size: 13px; color: var(--muted); letter-spacing: .06em; min-width: 0; }
  .lbl b { color: var(--text); font-size: 17px; letter-spacing: 0; overflow-wrap: anywhere; }
  .arr { width: 22px; height: 22px; margin-inline-start: auto; color: var(--muted); flex: none; }
  html[dir='rtl'] .arr { transform: scaleX(-1); }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr; } }
</style>
