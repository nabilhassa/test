---
// The MNH monogram as SVG, in one glowing copper colour (like the original icon).
//  - "solid": filled shapes – header, placeholders, fallback
//  - "draw":  lines that draw themselves, then fill – intro animation
import { pieces, order, SIZE, planet, toPath } from '../data/monogram';

interface Props {
  variant?: 'solid' | 'draw';
  withPlanet?: boolean;
  class?: string;
  title?: string;
  /** Main colour */
  color?: string;
  /** Extra line weight in screen pixels (thickens the bars a little at small sizes) */
  line?: number;
}
const { variant = 'solid', withPlanet = false, class: cls, title, color = '#ffb27a', line = 0.6 } = Astro.props;
const pad = 30;
const { cx, cy, r, ring } = planet;
---

<svg
  class={cls}
  viewBox={`${-pad} ${-pad} ${SIZE.w + pad * 2} ${SIZE.h + pad * 2}`}
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  aria-label={title}
  data-variant={variant}
  fill={color}
  stroke={color}
>
  {order.map((k) => (
    <path
      class={`piece ${k}`}
      d={toPath(pieces[k])}
      pathLength={variant === 'draw' ? 1 : undefined}
      stroke-width={line}
      vector-effect="non-scaling-stroke"
      stroke-linejoin="round"
    />
  ))}

  {withPlanet && (
    <g class="planet" fill="none">
      <ellipse cx={cx} cy={cy} rx={ring.rx} ry={ring.ry} transform={`rotate(${ring.angle} ${cx} ${cy})`} stroke-width="14" opacity=".5" />
      <circle cx={cx} cy={cy} r={r} fill="#06060f" stroke-width="12" />
      <path
        d={`M${cx - ring.rx} ${cy} A${ring.rx} ${ring.ry} 0 0 0 ${cx + ring.rx} ${cy}`}
        transform={`rotate(${ring.angle} ${cx} ${cy})`}
        stroke-width="18"
        stroke-linecap="round"
      />
    </g>
  )}
</svg>
