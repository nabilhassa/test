---
import { content } from '../data/site';
const s = content.start;
---

<!-- Teaser for the project brief; the button opens the multi-step form (BriefForm.astro) -->
<section class="section" id="start">
  <div class="wrap">
    <div class="panel reveal">
      <div class="corners" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
      <p class="kicker">{s.kicker}</p>
      <h2 class="h2 reveal" data-split>{s.title}</h2>
      <p class="text">{s.text}</p>
      <div class="actions">
        <button type="button" class="btn btn-primary" data-open-brief>
          {s.cta}
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
      <p class="note">{s.time}</p>
    </div>
  </div>
</section>

<style>
  .panel {
    position: relative;
    overflow: hidden;
    text-align: center;
    padding: clamp(48px, 8vw, 96px) clamp(22px, 6vw, 80px);
    border-radius: 28px;
    border: 1px solid var(--line-strong);
    background:
      radial-gradient(ellipse at 50% 0%, rgba(255,122,47,.22), transparent 60%),
      radial-gradient(ellipse at 0% 100%, rgba(34,211,197,.14), transparent 55%),
      radial-gradient(ellipse at 100% 100%, rgba(214,59,168,.14), transparent 55%),
      var(--panel);
    box-shadow: 0 40px 120px -50px rgba(255,122,47,.5);
  }
  .kicker { justify-content: center; }
  .h2 { max-width: 760px; margin-inline: auto; }
  .text { max-width: 680px; margin: 0 auto 36px; color: #cfcce0; }
  .actions { display: flex; justify-content: center; }
  .note { margin: 22px 0 0; font-size: 13px; color: var(--muted); }
  .corners i { position: absolute; width: 30px; height: 30px; border: 1.5px solid rgba(255,255,255,.3); }
  .corners i:nth-child(1) { top: 18px; left: 18px; border-right: 0; border-bottom: 0; }
  .corners i:nth-child(2) { top: 18px; right: 18px; border-left: 0; border-bottom: 0; }
  .corners i:nth-child(3) { bottom: 18px; left: 18px; border-right: 0; border-top: 0; }
  .corners i:nth-child(4) { bottom: 18px; right: 18px; border-left: 0; border-top: 0; }
</style>
