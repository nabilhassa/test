---
import { content } from '../data/site';
import Monogram from './Monogram.astro';
const w = content.why;
---

<section class="section why" id="why">
  <div class="wrap grid">
    <div class="visual reveal" data-mono-wrap>
      <canvas data-mono3d aria-label="3D MNH XMotion monogram" role="img"></canvas>
      <Monogram withPlanet class="fallback" />
      <span class="hint" aria-hidden="true">Move your mouse</span>
    </div>

    <div class="copy">
      <p class="kicker reveal">{w.kicker}</p>
      <p class="statement reveal" data-split>
        {w.statement.map((p) => (p.hl ? <span class="grad-text">{p.t}</span> : p.t))}
      </p>
      <p class="text reveal" style="--d:.16s">{w.text}</p>
      <ul class="pillars">
        {w.pillars.map((p, i) => (
          <li class="reveal" style={`--d:${0.2 + i * 0.08}s`} data-spot>
            <span class="k">{p.k}</span>
            <span class="t">{p.t}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .why { position: relative; overflow: hidden; background: var(--bg-2); border-block: 1px solid var(--line); }
  .grid { display: grid; grid-template-columns: 1fr 1.05fr; gap: clamp(24px, 5vw, 80px); align-items: center; }
  .visual { position: relative; aspect-ratio: 1; width: 100%; }
  .visual canvas { width: 100%; height: 100%; display: block; -webkit-mask-image: radial-gradient(circle at 50% 50%, #000 28%, rgba(0,0,0,.55) 50%, transparent 70%); mask-image: radial-gradient(circle at 50% 50%, #000 28%, rgba(0,0,0,.55) 50%, transparent 70%); opacity: 0; transition: opacity 1.2s; }
  .visual.ready canvas { opacity: 1; }
  .visual :global(.fallback) { position: absolute; inset: 20%; width: 60%; height: 60%; color: var(--copper-light); filter: drop-shadow(0 0 18px rgba(255,122,47,.8)); opacity: 0; transition: opacity .8s; }
  .visual.fallback :global(.fallback) { opacity: 1; }
  .hint { position: absolute; bottom: 8%; left: 50%; translate: -50% 0; font-size: 11px; letter-spacing: .3em; text-transform: uppercase; color: var(--muted); opacity: .7; white-space: nowrap; }
  @media (hover: none) { .hint { display: none; } }

  .statement { font-family: var(--font-display); font-weight: 700; font-size: clamp(36px, 5.2vw, 72px); line-height: 1.05; margin: 0 0 28px; text-wrap: balance; }
  html[lang='ar'] .statement { font-family: var(--font-ar); }
  .text { font-size: clamp(16px, 1.4vw, 18px); color: #cfcce0; margin: 0 0 40px; }
  .pillars { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
  .pillars li { position: relative; overflow: hidden; padding: 18px 20px; border: 1px solid var(--line); border-radius: 14px; background: rgba(14,15,30,.6); display: flex; gap: 14px; align-items: baseline; }
  .k { font-family: var(--font-display); color: var(--teal); font-size: 14px; letter-spacing: .14em; }
  .t { font-weight: 700; }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; }
    .visual { max-width: 480px; margin: -40px auto -30px; }
  }
  @media (max-width: 480px) { .pillars { grid-template-columns: 1fr; } }
</style>
