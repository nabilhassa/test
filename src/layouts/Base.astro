---
import '../styles/global.css';
import { getLang, locales, langMeta } from '../i18n';
import { contact } from '../data/site';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const lang = getLang(Astro.url);
const { dir, og } = langMeta[lang];
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const alt = (l: (typeof locales)[number]) => new URL(langMeta[l].path, Astro.site).href;
const ogImage = new URL('/og-image.jpg', Astro.site).href;
// Business details for Google (structured data)
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      '@id': 'https://mnhxmotion.com/#business',
      name: 'MNH XMotion',
      url: 'https://mnhxmotion.com/',
      logo: new URL('/favicon.svg', Astro.site).href,
      image: ogImage,
      description,
      email: contact.email,
      telephone: contact.phoneHref.replace('tel:', ''),
      sameAs: [contact.instagramHref],
      knowsLanguage: ['en', 'de', 'ar'],
      areaServed: 'Worldwide',
      serviceType: ['Video editing', 'Cinematic trailers', 'Content management', 'Ad creation', 'VFX', '3D animation', 'Motion graphics'],
    },
    { '@type': 'WebSite', '@id': 'https://mnhxmotion.com/#website', name: 'MNH XMotion', url: 'https://mnhxmotion.com/', inLanguage: lang },
  ],
};
---

<!doctype html>
<html lang={lang} dir={dir} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#06060f" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={og} />
    <meta property="og:site_name" content="MNH XMotion" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="MNH XMotion — cinematic video agency" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={alt(l)} />)}
    <link rel="alternate" hreflang="x-default" href={alt('en')} />
    <script is:inline>document.documentElement.classList.remove('no-js');</script>
  </head>
  <body>
    <slot />
    <script>
      // Reveal elements as they scroll into view
      const els = document.querySelectorAll('.reveal');
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
      );
      els.forEach((el) => io.observe(el));
    </script>
    <script>
      import '../scripts/fx';
    </script>
  </body>
</html>
