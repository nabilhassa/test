---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Portfolio from '../components/Portfolio.astro';
import WhyUs from '../components/WhyUs.astro';
import Process from '../components/Process.astro';
import Start from '../components/Start.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import Intro from '../components/Intro.astro';
import FilmStrip from '../components/FilmStrip.astro';
import BriefForm from '../components/BriefForm.astro';
---

<Base
  title="MNH XMotion: Cinematic Video Editing, 3D & VFX"
  description="MNH XMotion creates cinematic content and ads with storytelling, 3D animation and VFX for brands and content creators."
>
  <Intro />
  <Header />
  <main>
    <Hero />
    <FilmStrip words={['XMOTION', 'VFX', '3D ANIMATION', 'COLOR', 'STORYTELLING', 'ADS']} />
    <Services />
    <Portfolio />
    <WhyUs />
    <Process />
    <FilmStrip words={['HOOKS', 'TRAILERS', 'CONTENT', 'MOTION GRAPHICS', 'AI CREATIVITY', 'CINEMATIC EDITS']} reverse tilt={2} />
    <Start />
    <Contact />
  </main>
  <Footer />
  <BriefForm />
</Base>
